#!/usr/bin/env sh
set -e

echo "Running Axionvera Network pre-commit checks..."

export CARGO_TARGET_DIR=/tmp/axionvera-network-target

echo "1/6 Checking Rust formatting..."
cargo fmt --all -- --check

echo "2/6 Checking Soroban contract as WASM..."
cargo check -p axionvera-vault-contract --target wasm32-unknown-unknown

echo "3/6 Running Clippy on Soroban contract as WASM..."
cargo clippy -p axionvera-vault-contract --target wasm32-unknown-unknown -- -D warnings

echo "4/6 Checking native Rust crates..."
cargo check --workspace --exclude axionvera-vault-contract --all-targets

echo "5/6 Running native Rust tests..."
cargo test --workspace --exclude axionvera-vault-contract --all-targets

echo "6/6 Running Clippy on native Rust crates..."
cargo clippy --workspace --exclude axionvera-vault-contract --all-targets -- -D warnings

echo "Pre-commit checks passed."
