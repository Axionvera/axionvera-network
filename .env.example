# Axionvera Stellar Testnet Configuration Example
# Copy this file to .env and replace only the explicit contract-tooling
# placeholders in your private copy before a maintainer deployment.
# This committed example contains no secret keys, credentials, or private RPCs.

# Network-node configuration. These values mirror examples/testnet-config.json.
# Supported network names: local, testnet, mainnet, futurenet.
AXIONVERA_NETWORK_NAME=testnet

# Public Stellar testnet Soroban RPC endpoint. A maintainer may select another
# trusted testnet provider in an uncommitted .env file when required.
AXIONVERA_RPC_URL=https://soroban-testnet.stellar.org

# Supported environments: development, staging, production.
# Staging keeps testnet activity separate from local and production workloads.
AXIONVERA_ENVIRONMENT=staging

# Vault contract dry-run/deployment tooling.
# These values are intentionally non-functional placeholders. Never commit a
# secret seed, mnemonic, API key, or a maintainer's local identity data.
AXIONVERA_DEPLOYER_SOURCE=DEPLOYER_IDENTITY_PLACEHOLDER
AXIONVERA_ADMIN_ADDRESS=G_ADMIN_ADDRESS_PLACEHOLDER
AXIONVERA_DEPOSIT_TOKEN=C_DEPOSIT_TOKEN_PLACEHOLDER
AXIONVERA_REWARD_TOKEN=C_REWARD_TOKEN_PLACEHOLDER
