{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axionvera vault WASM build metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "target",
    "artifact_path",
    "sha256",
    "build_timestamp",
    "source_commit"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "package": { "type": "string", "const": "axionvera-vault-contract" },
    "target": { "type": "string", "const": "wasm32-unknown-unknown" },
    "artifact_path": {
      "type": "string",
      "const": "target/wasm32-unknown-unknown/release/axionvera_vault_contract.wasm"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "build_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(UNCOMMITTED|[0-9a-fA-F]{40})$"
    }
  }
}
