  "errors": [
    {
      "name": "AlreadyInitialized",
      "code": 1,
      "returned_by": [
        "initialize"
      ],
      "description": "The campaign protocol has already been initialized."
    },
    {
      "name": "NotInitialized",
      "code": 2,
      "returned_by": [
        "create_campaign",
        "fund_campaign",
        "add_activation_rule",
        "pause_campaign",
        "resume_campaign",
        "close_campaign",
        "available_unused_funds",
        "withdraw_unused_funds",
        "add_verifier",
        "remove_verifier",
        "is_verifier",
        "verify_and_allocate_reward",
        "claim_reward",
        "claimable_reward",
        "agent_total_earned",
        "get_activation_rule",
        "get_campaign",
        "protocol_admin",
        "next_campaign_id"
      ],
      "description": "A method requiring initialized protocol state was called before initialization."
    },
    {
      "name": "InvalidTimeRange",
      "code": 3,
      "returned_by": [
        "create_campaign"
      ],
      "description": "The campaign end time is not later than its start time."
    },
    {
      "name": "InvalidCap",
      "code": 4,
      "returned_by": [
        "create_campaign"
      ],
      "description": "The per-agent reward cap is negative."
    },
    {
      "name": "CampaignNotFound",
      "code": 5,
      "returned_by": [
        "fund_campaign",
        "add_activation_rule",
        "pause_campaign",
        "resume_campaign",
        "close_campaign",
        "available_unused_funds",
        "withdraw_unused_funds",
        "add_verifier",
        "remove_verifier",
        "is_verifier",
        "verify_and_allocate_reward",
        "claim_reward",
        "claimable_reward",
        "agent_total_earned",
        "get_campaign"
      ],
      "description": "The requested campaign does not exist in persistent storage."
    },
    {
      "name": "CampaignIdOverflow",
      "code": 6,
      "returned_by": [
        "create_campaign"
      ],
      "description": "Incrementing the next campaign identifier would overflow u64."
    },
    {
      "name": "InvalidAmount",
      "code": 7,
      "returned_by": [
        "fund_campaign",
        "withdraw_unused_funds"
      ],
      "description": "The supplied treasury amount is not positive."
    },
    {
      "name": "CampaignNotActive",
      "code": 8,
      "returned_by": [
        "fund_campaign",
        "add_activation_rule",
        "pause_campaign",
        "add_verifier",
        "remove_verifier",
        "verify_and_allocate_reward"
      ],
      "description": "The requested operation requires an active campaign."
    },
    {
      "name": "ArithmeticOverflow",
      "code": 9,
      "returned_by": [
        "fund_campaign",
        "withdraw_unused_funds",
        "verify_and_allocate_reward",
        "claim_reward"
      ],
      "description": "Checked campaign accounting arithmetic failed."
    },
    {
      "name": "InvalidRewardAmount",
      "code": 10,
      "returned_by": [
        "add_activation_rule"
      ],
      "description": "The activation rule reward amount is not positive."
    },
    {
      "name": "RuleAlreadyExists",
      "code": 11,
      "returned_by": [
        "add_activation_rule"
      ],
      "description": "An activation rule already exists for this campaign and milestone."
    },
    {
      "name": "RuleNotFound",
      "code": 12,
      "returned_by": [
        "verify_and_allocate_reward",
        "get_activation_rule"
      ],
      "description": "The requested activation rule does not exist."
    },
    {
      "name": "VerifierAlreadyExists",
      "code": 13,
      "returned_by": [
        "add_verifier"
      ],
      "description": "The verifier is already registered for this campaign."
    },
    {
      "name": "VerifierNotFound",
      "code": 14,
      "returned_by": [
        "remove_verifier"
      ],
      "description": "The verifier is not registered for this campaign."
    },
    {
      "name": "UnauthorizedVerifier",
      "code": 15,
      "returned_by": [
        "verify_and_allocate_reward"
      ],
      "description": "The authenticated verifier is not authorized for this campaign."
    },
    {
      "name": "RuleDisabled",
      "code": 16,
      "returned_by": [
        "verify_and_allocate_reward"
      ],
      "description": "The activation rule exists but is disabled."
    },
    {
      "name": "DuplicateActivation",
      "code": 17,
      "returned_by": [
        "verify_and_allocate_reward"
      ],
      "description": "The merchant reference and milestone activation has already been processed."
    },
    {
      "name": "InsufficientCampaignFunds",
      "code": 18,
      "returned_by": [
        "verify_and_allocate_reward"
      ],
      "description": "The campaign has insufficient unallocated funds for the reward."
    },
    {
      "name": "AgentCapExceeded",
      "code": 19,
      "returned_by": [
        "verify_and_allocate_reward"
      ],
      "description": "Allocating the reward would exceed the campaign's per-agent cap."
    },
    {
      "name": "NothingToClaim",
      "code": 20,
      "returned_by": [
        "claim_reward"
      ],
      "description": "The agent has no positive claimable reward."
    },
    {
      "name": "InvalidAccountingState",
      "code": 21,
      "returned_by": [
        "available_unused_funds",
        "withdraw_unused_funds",
        "claim_reward"
      ],
      "description": "Stored campaign accounting values violate an expected invariant."
    },
    {
      "name": "CampaignNotPaused",
      "code": 22,
      "returned_by": [
        "resume_campaign"
      ],
      "description": "The requested operation requires a paused campaign."
    },
    {
      "name": "CampaignAlreadyClosed",
      "code": 23,
      "returned_by": [
        "close_campaign"
      ],
      "description": "The campaign has already been permanently closed."
    },
    {
      "name": "CampaignNotClosed",
      "code": 24,
      "returned_by": [
        "withdraw_unused_funds"
      ],
      "description": "Unused campaign funds may only be withdrawn after closure."
    },
    {
      "name": "InsufficientUnusedFunds",
      "code": 25,
      "returned_by": [
        "withdraw_unused_funds"
      ],
      "description": "The requested withdrawal exceeds the campaign's unused funds."
    },
    {
      "name": "CampaignNotStarted",
      "code": 26,
      "returned_by": [
        "verify_and_allocate_reward"
      ],
      "description": "Reward allocation was attempted before the campaign start time."
    },
    {
      "name": "CampaignEnded",
      "code": 27,
      "returned_by": [
        "fund_campaign",
        "add_activation_rule",
        "pause_campaign",
        "resume_campaign",
        "add_verifier",
        "remove_verifier",
        "verify_and_allocate_reward"
      ],
      "description": "The requested operation is not permitted at or after the campaign end time."
    }
  ],
