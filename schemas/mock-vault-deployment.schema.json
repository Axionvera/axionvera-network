{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axionvera mocked vault deployment handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mocked", "status", "source_commit", "network_mode", "wasm", "contract_id", "initialization", "maintainer_deployment_boundary"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "mocked": { "type": "boolean", "const": true },
    "status": { "type": "string", "const": "ready_for_maintainer_deployment" },
    "source_commit": {
      "type": "string",
      "pattern": "^(UNCOMMITTED|[0-9a-fA-F]{40})$"
    },
    "network_mode": { "type": "string", "const": "testnet" },
    "wasm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "const": "target/wasm32-unknown-unknown/release/axionvera_vault_contract.wasm"
        },
        "sha256": {
          "type": "string",
          "pattern": "^(SHA256_PLACEHOLDER|[0-9a-fA-F]{64})$"
        }
      }
    },
    "contract_id": {
      "type": "string",
      "pattern": "^(CONTRACT_ID_PLACEHOLDER|C[A-Z2-7]{55})$"
    },
    "initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admin", "deposit_token", "reward_token"],
      "properties": {
        "admin": { "$ref": "#/$defs/address_or_placeholder" },
        "deposit_token": { "$ref": "#/$defs/address_or_placeholder" },
        "reward_token": { "$ref": "#/$defs/address_or_placeholder" }
      }
    },
    "maintainer_deployment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "real_deployment_performed"],
      "properties": {
        "required": { "type": "boolean", "const": true },
        "real_deployment_performed": { "type": "boolean", "const": false }
      }
    }
  },
  "$defs": {
    "address_or_placeholder": {
      "type": "string",
      "pattern": "^(ADDRESS_PLACEHOLDER|G[A-Z2-7]{55}|C[A-Z2-7]{55})$"
    }
  }
}
